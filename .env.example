# ─────────────────────────────────────────────────────────────
# Central de Notificações Push — Brokers Brasil
# Copie este arquivo para ".env" e preencha os valores.
# ─────────────────────────────────────────────────────────────

# Porta do servidor HTTP interno (o Nginx faz o proxy do HTTPS para cá)
PORT=3000

# "production" em servidor, "development" na máquina local.
# Em production o cookie de sessão vira Secure (só trafega em HTTPS).
NODE_ENV=development

# Endereço público final do app. Usado no clique da notificação.
APP_URL=http://localhost:3000

# Caminho do arquivo SQLite. Em produção prefira um caminho absoluto,
# por exemplo /var/lib/bbr-push/dados.db
DB_PATH=./dados/central.db

# Segredo que assina o cookie de sessão. Gere um valor longo e aleatório:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-valor-por-um-segredo-longo-e-aleatorio

# Duração da sessão (aceita "7d", "12h", "30m")
SESSAO_DURACAO=30d

# ── Chaves VAPID ────────────────────────────────────────────
# Gere UMA vez com "npm run vapid" e reuse para sempre.
# Trocar as chaves invalida todos os aparelhos já inscritos.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Identificação do remetente exigida pelo protocolo Web Push.
VAPID_SUBJECT=mailto:contato@brokersbrasil.com.br

# ── Administrador inicial ───────────────────────────────────
# Criado automaticamente na primeira execução, se ainda não existir.
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@brokersbrasil.com.br
ADMIN_SENHA=troque-esta-senha

# Defina como 1 quando o app estiver atrás de um proxy reverso (Nginx,
# Caddy, Cloudflare). Necessário para o rate limit ler o IP real.
TRUST_PROXY=0
